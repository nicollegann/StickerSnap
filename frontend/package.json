    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "typescript": "~5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.1.8"
